# ==========================================
# SHOPEE NEW PRODUCT MONITOR CONFIGURATION
# ==========================================

# Telegram Bot Token (obtain from @BotFather)
TELEGRAM_BOT_TOKEN=8753686508:AAFE8fECmXutzkz3yNw8hI-kt2wmyPG78Ao

# Telegram Target Chat ID (user ID or group ID, e.g. -100123456789)
TELEGRAM_CHAT_ID=-1004358778817

# Polling interval in minutes (default: 10)
POLL_INTERVAL_MINUTES=1

# Maximum concurrent requests when checking shops (default: 3)
MAX_CONCURRENT_REQUESTS=5

# Delay between shop requests in milliseconds (default: 1000)
REQUEST_DELAY_MS=200

# Path to SQLite database file
DATABASE_PATH=./data/monitor.db

# Data Provider Mode:
# 'zenrows'     : ZenRows Scraping Cloud (Bypasses Shopee WAF 90309999 without local Chrome)
# 'browser'     : Headless Chrome / Seller Centre real-time provider
# 'shopee-http' : Real Shopee Vietnam public API
# 'mock'        : Simulated provider for testing and validation
DATA_PROVIDER=zenrows

# ZenRows API Key (get free key from https://www.zenrows.com/)
ZENROWS_API_KEY=your_zenrows_api_key_here

# Optional: Shopee Browser Cookie
